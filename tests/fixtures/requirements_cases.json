    {
      "name": "duplicates collapse and keep the strongest flag",
      "input": [
        {
          "slug": "a",
          "name": "Maintain hygiene",
          "mandatory": false,
          "importance": 2
        },
        {
          "slug": "b",
          "name": "maintain  hygiene",
          "mandatory": true,
          "importance": 3
        }
      ],
      "expect": {
        "main": [
          {
            "slug": "b",
            "name": "maintain  hygiene",
            "mandatory": true,
            "importance": 3
          }
        ],
        "also": []
      }
    },
    {
      "name": "the stronger duplicate may come first: it is kept, with the highest importance of the two",
