# Copy to .env and fill in real values. Never commit .env.

ENVIRONMENT=development

# Database (ADR-003: PostgreSQL + pgvector)
DATABASE_URL=postgresql+asyncpg://iism:iism@localhost:5432/iism

# Redis (ADR-006 async workers, ADR-020 caching)
REDIS_URL=redis://localhost:6379/0

# Auth (ADR-009: centralized identity, JWT)
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# External LLM provider (ADR-018: use external LLMs, not custom-trained)
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5
