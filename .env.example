ENVIRONMENT=development
APP_VERSION=0.1.0
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000

# Host ports are non-default (5433/6380) to avoid clashing with any local install.
DATABASE_URL=postgresql+asyncpg://iism:iism@localhost:5433/iism
REDIS_URL=redis://localhost:6380/0

# NSQF source of record (ADR-034). Read only by the importer, never at request time.
MONGO_URL=mongodb://iism:iism@localhost:27018/?authSource=admin
MONGO_DATABASE=nsqf

DB_ECHO=false

# --- auth ---
# Must be >= 32 bytes outside development; generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-in-production
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Development convenience: the OTP is returned in the API response and logged.
# Never enable outside development.
OTP_EXPOSE_IN_RESPONSE=true
