# Every setting `api/core/config.py` declares appears here, defaults included.
# A setting with a default that is absent from this file is a setting an
# operator has to read the source to discover -- and the OTP limits below are
# the security-relevant knobs of the whole auth path.

APP_NAME=Intelligent Integrated Skill Marketplace
ENVIRONMENT=development
APP_VERSION=0.1.0
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000

# Host ports are non-default (5433/6380) to avoid clashing with any local install.
DATABASE_URL=postgresql+asyncpg://iism:iism@localhost:5433/iism
REDIS_URL=redis://localhost:6380/0

# NSQF source of record (ADR-034). Read only by the importer, never at request time.
MONGO_URL=mongodb://iism:iism@localhost:27018/?authSource=admin
MONGO_DATABASE=iism_nsqf_master_data

DB_ECHO=false

# --- auth ---
# Must be >= 32 bytes outside development; generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- OTP ---
# The rate limits, not just the code. There is no password anywhere in the
# product (ADR-038), so these five values are the entire brute-force budget:
# OTP_MAX_ATTEMPTS guesses per code, and OTP_REQUEST_LIMIT new codes per
# identifier per OTP_REQUEST_WINDOW_SECONDS. Raising either widens the only
# door into every account.
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_LIMIT=5
OTP_REQUEST_WINDOW_SECONDS=900

# Development convenience: the OTP is returned in the API response so the flow
# can be exercised without an SMS vendor. It is **never logged** -- ADR-023 and
# `api/core/redaction.py` both forbid it, and the filter masks any `code` key
# that reaches a log line. Never enable this outside development.
OTP_EXPOSE_IN_RESPONSE=true

# --- logging ---
# `json` for anything a collector reads; `console` for a human at a terminal.
# The setting defaults to `json`, so a missing variable fails toward the
# machine-readable format rather than away from it.
LOG_LEVEL=INFO
LOG_FORMAT=console
